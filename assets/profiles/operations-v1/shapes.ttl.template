ex:ProjectShape a sh:NodeShape; sh:targetNode ex:project;
 rdfs:label "ProjectShape"; rdfs:comment "Required operations profile constraint ProjectShape";
 rdfs:isDefinedBy <https://evopilot.dev/profiles/operations/v1/>; rdfs:seeAlso <https://evopilot.dev/profiles/operations/v1/ProjectShape>;
 sh:sparql [ sh:message "Operations profile violation: ProjectShape"; sh:select """
PREFIX ex: <{{NS}}>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { FILTER(!EXISTS { $this a ex:Project } || !(EXISTS { $this ex:workspaceId ?v . FILTER(datatype(?v) = xsd:string && STRLEN(STR(?v)) > 0) } && !EXISTS { $this ex:workspaceId ?v1, ?v2 . FILTER(?v1 != ?v2) } && EXISTS { $this ex:projectId ?v . FILTER(datatype(?v) = xsd:string && STRLEN(STR(?v)) > 0) } && !EXISTS { $this ex:projectId ?v1, ?v2 . FILTER(?v1 != ?v2) } && EXISTS { $this ex:hasCapability ?v . ?v a ex:BusinessCapability } && !EXISTS { $this ex:hasCapability ?v . FILTER(!isIRI(?v) || !EXISTS { ?v a ex:BusinessCapability }) })) }
""" ] .

