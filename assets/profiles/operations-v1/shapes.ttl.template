ex:OwnerReferenceShape a sh:NodeShape; sh:targetNode ex:project;
 rdfs:label "OwnerReferenceShape"; rdfs:comment "Required operations profile constraint OwnerReferenceShape";
 rdfs:isDefinedBy <https://evopilot.dev/profiles/operations/v1/>; rdfs:seeAlso <https://evopilot.dev/profiles/operations/v1/OwnerReferenceShape>;
 sh:sparql [ sh:message "Operations profile violation: OwnerReferenceShape"; sh:select """
PREFIX ex: <{{NS}}>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { FILTER(!EXISTS { ?ref a ex:OwnerEvidenceReference } || EXISTS { ?ref a ex:OwnerEvidenceReference . FILTER(!(EXISTS { ?ref ex:owner ?v . FILTER(datatype(?v) = xsd:string && STRLEN(STR(?v)) > 0) } && !EXISTS { ?ref ex:owner ?v1, ?v2 . FILTER(?v1 != ?v2) } && EXISTS { ?ref ex:recordKind ?v . FILTER(datatype(?v) = xsd:string && STRLEN(STR(?v)) > 0) } && !EXISTS { ?ref ex:recordKind ?v1, ?v2 . FILTER(?v1 != ?v2) } && EXISTS { ?ref ex:recordId ?v . FILTER(datatype(?v) = xsd:string && STRLEN(STR(?v)) > 0) } && !EXISTS { ?ref ex:recordId ?v1, ?v2 . FILTER(?v1 != ?v2) } && EXISTS { ?ref ex:revision ?v . FILTER(datatype(?v) = xsd:string && STRLEN(STR(?v)) > 0) } && !EXISTS { ?ref ex:revision ?v1, ?v2 . FILTER(?v1 != ?v2) } && EXISTS { ?ref ex:digest ?v . FILTER(datatype(?v) = xsd:string && STRLEN(STR(?v)) > 0) } && !EXISTS { ?ref ex:digest ?v1, ?v2 . FILTER(?v1 != ?v2) } && EXISTS { ?ref ex:workspaceId ?v . FILTER(datatype(?v) = xsd:string && STRLEN(STR(?v)) > 0) } && !EXISTS { ?ref ex:workspaceId ?v1, ?v2 . FILTER(?v1 != ?v2) } && EXISTS { ?ref ex:projectId ?v . FILTER(datatype(?v) = xsd:string && STRLEN(STR(?v)) > 0) } && !EXISTS { ?ref ex:projectId ?v1, ?v2 . FILTER(?v1 != ?v2) } && EXISTS { ?ref ex:owner ?owner . FILTER(?owner IN ("runtime","harness","ontology","workspace")) } && EXISTS { ?ref ex:recordKind ?kind . FILTER(?kind IN ("finding","observation","problem","run","collection","native-package","decision","runbook")) } && EXISTS { ?ref ex:digest ?digest . FILTER(REGEX(STR(?digest), "^sha256:[a-f0-9]{64}$")) } && EXISTS { ?ref ex:at ?at . FILTER(datatype(?at) = xsd:integer && ?at >= 0) } && !EXISTS { ?ref ex:at ?v1, ?v2 . FILTER(?v1 != ?v2) })) }) }
""" ] .

ex:RunbookShape a sh:NodeShape; sh:targetNode ex:project;
 rdfs:label "RunbookShape"; rdfs:comment "Required operations profile constraint RunbookShape";
 rdfs:isDefinedBy <https://evopilot.dev/profiles/operations/v1/>; rdfs:seeAlso <https://evopilot.dev/profiles/operations/v1/RunbookShape>;
