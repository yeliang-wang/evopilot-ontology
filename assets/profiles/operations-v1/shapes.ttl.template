 rdfs:isDefinedBy <https://evopilot.dev/profiles/operations/v1/>; rdfs:seeAlso <https://evopilot.dev/profiles/operations/v1/CauseShape>;
 sh:sparql [ sh:message "Operations profile violation: CauseShape"; sh:select """
PREFIX ex: <{{NS}}>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE { FILTER(!EXISTS { ?cause a ex:CauseAssertion } || EXISTS { ?cause a ex:CauseAssertion . FILTER(!(EXISTS { ?cause ex:classification ?v . FILTER(datatype(?v) = xsd:string && STRLEN(STR(?v)) > 0) } && !EXISTS { ?cause ex:classification ?v1, ?v2 . FILTER(?v1 != ?v2) } && EXISTS { ?cause ex:classification ?kind . FILTER(?kind IN ("OBSERVED", "SUSPECTED", "CONFIRMED")) } && EXISTS { ?cause ex:rationale ?v . FILTER(datatype(?v) = xsd:string && STRLEN(STR(?v)) > 0) } && !EXISTS { ?cause ex:rationale ?v1, ?v2 . FILTER(?v1 != ?v2) } && EXISTS { ?cause ex:hasEvidence ?v . ?v a ex:OwnerEvidenceReference } && !EXISTS { ?cause ex:hasEvidence ?v . FILTER(!isIRI(?v) || !EXISTS { ?v a ex:OwnerEvidenceReference }) })) } || EXISTS { ?cause a ex:CauseAssertion; ex:classification "CONFIRMED" . FILTER(!EXISTS { ?cause ex:decisionEvidence ?decision . ?decision a ex:OwnerEvidenceReference; ex:recordKind "decision" }) } || EXISTS { ?cause ex:classification ?kind; ex:decisionEvidence ?decision . FILTER(?kind != "CONFIRMED") }) }
