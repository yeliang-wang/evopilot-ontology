{
  "name": "@evopilot-next/ontology",
  "version": "0.8.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "files": [
    "dist",
    "plugins",
    "governance",
    "src",
    "vendor",
    "README.md",
    "README_CN.md",
    "specifications",
    "examples",
    "schemas",
    "docs",
    "provenance",
    "LICENSE",
    "NOTICE",
    "assets",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compat": {
      "types": "./dist/compat/index.d.mts",
      "import": "./dist/compat/index.mjs"
    },
    "./migration": {
      "types": "./dist/migration.d.ts",
      "import": "./dist/migration.js"
    },
    "./sources": {
      "types": "./dist/asset-sources.d.ts",
      "import": "./dist/asset-sources.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "import": "./dist/service.js"
    },
    "./workspace-migration": {
      "types": "./dist/workspace-migration.d.ts",
      "import": "./dist/workspace-migration.js"
    },
    "./standalone": {
      "types": "./dist/standalone/http.d.ts",
      "import": "./dist/standalone/http.js"
    },
    "./standalone-client": {
      "types": "./dist/standalone/client.d.ts",
      "import": "./dist/standalone/client.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit && node scripts/check.mjs",
    "test": "node --test tests/e2e/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "ajv": "8.20.0",
    "yaml": "2.9.0"
  },
  "license": "Apache-2.0",
  "bin": {
    "evopilot-next-ontology": "dist/cli.js",
    "evopilot-ontology": "dist/standalone/cli.js"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
