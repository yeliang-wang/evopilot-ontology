{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "evopilot-ontology-cases/v1"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "data": {
            "type": "string",
            "pattern": "^tests/.*\\.ttl$"
          },
          "expectedConforms": {
            "type": "boolean"
          },
          "requirementIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "shapeIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(https?://|urn:)"
            }
          }
        },
        "required": [
          "id",
          "data",
          "expectedConforms",
          "requirementIds",
          "shapeIds"
        ]
      }
    }
  },
  "required": [
    "schema",
    "cases"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
