{
  "schema": "evopilot-standard-support/v1",
  "owner": "ontology",
  "specVersion": "v1",
  "entries": [
    {
      "id": "rdf-turtle",
      "standard": "RDF 1.1 / Turtle 1.1",
      "officialURL": "https://www.w3.org/TR/turtle/",
      "clause": "RDF graphs and Turtle",
      "status": "SUPPORTED",
      "adoptedMeaning": "UTF-8 Turtle only; graph set semantics, stable business IRIs",
      "testIds": [
        "O01",
        "O04",
        "O10"
      ]
    },
    {
      "id": "rdfs-owl-declarations",
      "standard": "RDFS 1.1 / OWL 2 2012",
      "officialURL": "https://www.w3.org/TR/owl2-overview/",
      "clause": "Named declarations",
      "status": "RESTRICTED",
      "adoptedMeaning": "Declared classes/properties/labels/comments/domain/range/subclass/subproperty only; inference none; no OWL consistency or inferred facts",
      "testIds": [
        "O02",
        "O07"
      ]
    },
    {
      "id": "core-value-type",
      "standard": "SHACL 2017",
      "officialURL": "https://www.w3.org/TR/2017/REC-shacl-20170720/#core-components-value-type",
