      "clause": "4.3",
      "status": "SUPPORTED",
      "adoptedMeaning": "min/max Exclusive/Inclusive",
      "testIds": [
        "O02"
      ]
    },
    {
      "id": "core-string",
      "standard": "SHACL 2017",
      "officialURL": "https://www.w3.org/TR/2017/REC-shacl-20170720/#core-components-string",
      "clause": "4.4",
      "status": "SUPPORTED",
      "adoptedMeaning": "min/maxLength, pattern/flags, languageIn, uniqueLang",
      "testIds": [
        "O02"
      ]
    },
    {
      "id": "core-property-pair",
      "standard": "SHACL 2017",
      "officialURL": "https://www.w3.org/TR/2017/REC-shacl-20170720/#core-components-property-pairs",
      "clause": "4.5",
      "status": "SUPPORTED",
      "adoptedMeaning": "equals/disjoint/lessThan/lessThanOrEquals",
      "testIds": [
        "O03"
      ]
    },
    {
      "id": "core-logical",
      "standard": "SHACL 2017",
      "officialURL": "https://www.w3.org/TR/2017/REC-shacl-20170720/#core-components-logical",
      "clause": "4.6",
      "status": "SUPPORTED",
      "adoptedMeaning": "and/or/not/xone, non-recursive shapes",
      "testIds": [
        "O03",
        "O07"
      ]
    },
    {
      "id": "core-shape",
      "standard": "SHACL 2017",
      "officialURL": "https://www.w3.org/TR/2017/REC-shacl-20170720/#core-components-shape",
      "clause": "4.7",
      "status": "RESTRICTED",
      "adoptedMeaning": "node and qualifiedValueShape/counts; recursion refused",
      "testIds": [
        "O03",
        "O07"
      ]
    },
    {
      "id": "core-other",
      "standard": "SHACL 2017",
      "officialURL": "https://www.w3.org/TR/2017/REC-shacl-20170720/#core-components-other",
      "clause": "4.8",
      "status": "SUPPORTED",
      "adoptedMeaning": "closed/ignoredProperties, hasValue, in",
      "testIds": [
        "O02",
        "O03"
      ]
    },
    {
      "id": "targets-paths",
      "standard": "SHACL 2017",
      "officialURL": "https://www.w3.org/TR/2017/REC-shacl-20170720/#targets",
      "clause": "2.1.3, 2.3",
      "status": "RESTRICTED",
      "adoptedMeaning": "Core targets/paths; fixed root targetNode, expected IDs/types and required shapes; no focus or shape subset selection",
      "testIds": [
        "O05",
        "O06"
      ]
    },
    {
      "id": "sparql",
      "standard": "SHACL 2017",
      "officialURL": "https://www.w3.org/TR/2017/REC-shacl-20170720/#sparql-constraints",
      "clause": "5",
      "status": "RESTRICTED",
      "adoptedMeaning": "Local SELECT only; no SERVICE/FROM/GRAPH/VALUES/MINUS/Update/custom functions",
      "testIds": [
        "O08",
        "O09"
      ]
    },
    {
      "id": "meta",
      "standard": "SHACL 2017 plus EvoPilot adoption",
      "officialURL": "https://www.w3.org/TR/2017/REC-shacl-20170720/#shapes-graph",
      "clause": "Shapes graph",
      "status": "RESTRICTED",
      "adoptedMeaning": "meta-SHACL plus executable-vocabulary/recursion checks and EvoPilot required declaration metadata",
      "testIds": [
        "O07"
      ]
    },
    {
      "id": "extensions",
      "standard": "SHACL-JS / SHACL-AF / custom components",
      "officialURL": "https://www.w3.org/TR/shacl-af/",
      "clause": "Not adopted",
      "status": "UNSUPPORTED",
      "adoptedMeaning": "No executable extensions, external imports, recursion, RDF-star or multi named graphs",
      "testIds": [
        "O07",
        "O08"
      ]
    },
    {
      "id": "scope-bindings",
      "standard": "EvoPilot convention",
      "officialURL": "https://github.com/yeliang-wang/evopilot-ontology",
      "clause": "Project closure",
      "status": "SUPPORTED",
      "adoptedMeaning": "Independent requirements, expected identities, shapes and case IDs; source status and namespace ownership",
      "testIds": [
        "O03",
        "O05",
        "O06",
        "O12"
      ]
    },
    {
      "id": "report",
      "standard": "SHACL 2017",
      "officialURL": "https://www.w3.org/TR/2017/REC-shacl-20170720/#validation-report",
      "clause": "3.6",
      "status": "SUPPORTED",
      "adoptedMeaning": "Native raw graph; code/report agreement; required Warning/Info fail; timeout/errors never conform",
      "testIds": [
        "O10",
        "O11"
      ]
    }
