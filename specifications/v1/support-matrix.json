      "clause": "4.2",
      "status": "SUPPORTED",
      "adoptedMeaning": "minCount/maxCount; duplicate triples do not represent multiple events",
      "testIds": [
        "O04"
      ]
    },
    {
      "id": "core-range",
      "standard": "SHACL 2017",
